# REQUIRED — server cannot decrypt download links without this.
# Must match the key used to encrypt links in the Admin Dashboard.
# DO NOT leave blank. Generate: openssl rand -hex 32
AES_SECRET=REPLACE_WITH_YOUR_REAL_KEY

# REQUIRED in production. Randomises per restart if not set (tokens break on redeploy).
# Generate: openssl rand -hex 32
TOKEN_SECRET=REPLACE_WITH_YOUR_REAL_KEY

# Optional — Cloudflare Turnstile. Leave blank to disable.
CF_TURNSTILE_SECRET=
VITE_CF_TURNSTILE_SITE_KEY=

# Optional — Administrator configuration. Defaults to defentechscholar@gmail.com if not specified.
ADMIN_EMAIL=
VITE_ADMIN_EMAIL=

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=gen-lang-client-0825832493
VITE_FIREBASE_APP_ID=1:103973989874:web:733a6afd8e837224900f6b
VITE_FIREBASE_API_KEY=AIzaSyBey9sUbeWrcXS2kl4ewOzkTy4arg03Ok
VITE_FIREBASE_AUTH_DOMAIN=gen-lang-client-0825832493.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=ai-studio-yonostore-886315a4-8b9f-4ff6-8986-a90ad172210a
VITE_FIREBASE_STORAGE_BUCKET=gen-lang-client-0825832493.firebasestorage.app
VITE_FIREBASE_MESSAGING_ID=103973989874

# Admin Settings
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Firebase Admin SDK (Recommended: Put in Settings -> Environment Variables)
# Alternatively, you can save the JSON to /service-account.json (auto-detected).
FIREBASE_SERVICE_ACCOUNT=

# GitHub Sync Token (Recommended for security instead of UI entry)
