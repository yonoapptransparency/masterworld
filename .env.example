# Required for AI HTML Formatting in the Admin Dashboard
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Required for Live Web Research (Mode 2)
GEMINI_RESEARCH_API_KEY=

# REQUIRED — server cannot decrypt download links without this.
# v2 AES-256-GCM 32-byte key (base64): openssl rand -base64 32
AES_KEY=
AES_KEY_PREVIOUS=
# Legacy passphrase (only until v2 migration ends)
AES_SECRET=REPLACE_WITH_YOUR_REAL_KEY

# Stateless Nonce & Device Cookie HMAC Secrets (§7)
# Generate: openssl rand -hex 32
NONCE_HMAC_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
NONCE_HMAC_SECRET_PREVIOUS=
DID_HMAC_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
TOKEN_SECRET=REPLACE_WITH_YOUR_REAL_KEY

# Gateway Origin & Host Allowlist (§7)
ALLOWED_HOSTNAMES=www.rummydex.com,rummydex.com
X_CF_AUTH_SECRET=

# Cloudflare Turnstile Configuration
# Client-side Site Key (Public widget key)
VITE_TURNSTILE_SITE_KEY=<turnstile-site-key>
# Server-side Secret Key (Private key from Cloudflare Turnstile dashboard - NOT the site key)
TURNSTILE_SECRET_KEY=<turnstile-secret-key>

# Upstash Redis Configuration (Distributed Cross-Instance Nonce Burn & Rate Limiting)
# Free database at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Administrator Authentication Credentials (Required to access Admin Panel)
ADMIN_EMAIL=admin@example.com
VITE_ADMIN_EMAIL=admin@example.com

# Firebase Configuration
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:100000000000:web:0000000000000000000000
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_ID=100000000000

# Admin Settings
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Firebase Admin SDK (Recommended: Put in Settings -> Environment Variables)
# Alternatively, you can save the JSON to /service-account.json (auto-detected).
FIREBASE_SERVICE_ACCOUNT=

# GitHub Sync Token (Recommended for security instead of UI entry)
PAT=

# Public Website URL for SEO Canonical Tags (e.g., https://www.dex.com)
VITE_PUBLIC_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Community Database (Reviews/Reports) Configuration - rummydexcommunity
# This separate Firebase instance handles all public community reviews, ratings, and reports.
COMMUNITY_FIREBASE_PROJECT_ID=rummydexcommunity
COMMUNITY_FIREBASE_DATABASE_ID=(default)
COMMUNITY_FIREBASE_API_KEY=
COMMUNITY_FIREBASE_APP_ID=
COMMUNITY_FIREBASE_SERVICE_ACCOUNT=
VITE_COMMUNITY_FIREBASE_PROJECT_ID=rummydexcommunity
VITE_COMMUNITY_FIREBASE_DATABASE_ID=(default)
VITE_COMMUNITY_FIREBASE_API_KEY=
VITE_COMMUNITY_FIREBASE_APP_ID=
VITE_COMMUNITY_FIREBASE_AUTH_DOMAIN=rummydexcommunity.firebaseapp.com
VITE_COMMUNITY_FIREBASE_STORAGE_BUCKET=rummydexcommunity.firebasestorage.app

