{
  "version": 2,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/public/backup-data",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/index"
    },
    {
      "source": "/opensearch.xml",
      "destination": "/api/index"
    },
    {
      "source": "/(site\\.webmanifest|manifest\\.json|favicon\\.ico|favicon\\.png|favicon-32x32\\.png|favicon-16x16\\.png|apple-touch-icon\\.png|apple-touch-icon-precomposed\\.png|android-chrome-192x192\\.png|android-chrome-512x512\\.png|logo\\.png)",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(sitemap\\.xml|rss\\.xml|opensearch\\.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60, stale-while-revalidate=600" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.png|favicon-32x32\\.png|favicon-16x16\\.png|apple-touch-icon\\.png|apple-touch-icon-precomposed\\.png|android-chrome-192x192\\.png|android-chrome-512x512\\.png|logo\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Expires", "value": "Thu, 31 Dec 2037 23:59:59 GMT" },
        { "key": "Vary", "value": "Accept-Encoding" }
      ]
    }
  ]
}