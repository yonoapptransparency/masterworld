# 5. Clearance Gateway Security (Strict no-store)
/moreinfo/*
  Cache-Control: no-store, no-cache, must-revalidate, private, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer

# 6. HTML entry point fallback (Universal instant fresh delivery)
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: public, max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: public, max-age=0, must-revalidate

# 7. Global Security & Modern Browser Headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
